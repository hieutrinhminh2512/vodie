# Sao chép file này thành .env rồi điền key (để trống nếu không dùng)

# Đạo diễn AI bằng Claude: chia vai, cảm xúc, nhịp kể chuẩn văn hóa truyện ma Việt.
# Không có key -> dùng đạo diễn theo luật (miễn phí, kém tinh tế hơn).
ANTHROPIC_API_KEY=
# Mặc định claude-opus-5-5. Muốn rẻ hơn có thể đặt claude-sonnet-5-5
VODIE_LLM_MODEL=

# ElevenLabs (tùy chọn, trả phí) — đặt tts.engine: elevenlabs trong config/settings.yaml
ELEVENLABS_API_KEY=

# Hugging Face token (tùy chọn) — tải model VieNeu nhanh hơn lần đầu
HF_TOKEN=
